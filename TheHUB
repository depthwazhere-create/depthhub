-- Depth Hub prank:
--   1. Small centered dialog titled "Depth Hub"
--   2. "100% completed  press load the script"
--   3. Button "Load Script" — actually kicks you with the ban message

local Players              = game:GetService("Players")
local TweenService         = game:GetService("TweenService")
local ContextActionService = game:GetService("ContextActionService")
local RunService           = game:GetService("RunService")

------------------------------------------------------------
-- STEP 1: Destroy every previous copy from every parent
------------------------------------------------------------
for _, p in ipairs({
    game:GetService("CoreGui"),
    Players.LocalPlayer:FindFirstChild("PlayerGui"),
    (gethui and gethui()) or nil,
}) do
    if p then
        for _, c in ipairs(p:GetDescendants()) do
            if c.Name == "FakeKickScreen" then c:Destroy() end
        end
    end
end

local parent = (gethui and gethui())
    or Players.LocalPlayer:FindFirstChild("PlayerGui")
    or game:GetService("CoreGui")

------------------------------------------------------------
-- Config
------------------------------------------------------------
local TITLE_TEXT  = "Depth Hub"
local TOP_MESSAGE = "100% completed  press load the script"
local BAN_MESSAGE = "You have been permanently banned from this experience."
local ERROR_CODE  = "Error Code: 832"
local BUTTON_TEXT = "Load Script"

------------------------------------------------------------
-- GUI
------------------------------------------------------------
local gui = Instance.new("ScreenGui")
gui.Name = "FakeKickScreen"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.DisplayOrder = 999999
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = parent

-- Freeze movement while screen is up
local function freezeChar(char)
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.WalkSpeed = 0
        hum.JumpPower = 0
        hum.JumpHeight = 0
    end
end
if Players.LocalPlayer.Character then freezeChar(Players.LocalPlayer.Character) end
Players.LocalPlayer.CharacterAdded:Connect(freezeChar)

local conn
conn = RunService.RenderStepped:Connect(function()
    if not gui.Parent then conn:Disconnect() return end
    local char = Players.LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = 0; hum.JumpPower = 0; hum.JumpHeight = 0 end
    end
end)

for _, action in ipairs({
    "jumpAction", "moveForwardAction", "moveBackwardAction",
    "moveLeftAction", "moveRightAction",
    "forward", "backward", "left", "right", "jump",
}) do
    ContextActionService:BindAction(
        "Block_" .. action,
        function() return Enum.ContextActionResult.Sink end,
        false,
        unpack(Enum.PlayerActions:GetEnumItems())
    )
end

-- Single centered dialog box
