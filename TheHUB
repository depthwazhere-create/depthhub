-- Load Script button
local button = Instance.new("TextButton")
button.Size = UDim2.new(1, 0, 0, 62)
button.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
button.BorderSizePixel = 0
button.Text = BUTTON_TEXT
button.TextColor3 = Color3.fromRGB(30, 30, 30)
button.Font = Enum.Font.GothamMedium
button.TextSize = 24
button.AutoButtonColor = false
button.LayoutOrder = 6
button.Parent = dialog

local btnCorner = Instance.new("UICorner")
btnCorner.CornerRadius = UDim.new(0, 10)
btnCorner.Parent = button

local hoverIn  = TweenService:Create(button, TweenInfo.new(0.12), { BackgroundColor3 = Color3.fromRGB(230, 230, 230) })
local hoverOut = TweenService:Create(button, TweenInfo.new(0.12), { BackgroundColor3 = Color3.fromRGB(255, 255, 255) })
button.MouseEnter:Connect(function() hoverIn:Play() end)
button.MouseLeave:Connect(function() hoverOut:Play() end)

------------------------------------------------------------
-- Button: actually kicks you
------------------------------------------------------------
local clicked = false
button.MouseButton1Click:Connect(function()
    if clicked then return end
    clicked = true
    button.Text = "Loading..."
    button.Active = false
    task.wait(0.3)
    Players.LocalPlayer:Kick(BAN_MESSAGE .. "\n\n" .. ERROR_CODE)
end)
