dialog.BackgroundColor3 = Color3.fromRGB(57, 57, 57)
dialog.BorderSizePixel = 0
dialog.Text = ""
dialog.AutoButtonColor = false
dialog.Modal = true
dialog.Parent = gui

local pad = Instance.new("UIPadding")
pad.PaddingTop    = UDim.new(0, 28)
pad.PaddingBottom = UDim.new(0, 28)
pad.PaddingLeft   = UDim.new(0, 32)
pad.PaddingRight  = UDim.new(0, 32)
